# Переключение между MockApiClient (фикстуры, поведение по умолчанию — все текущие
# unit/e2e-тесты рассчитаны на него) и RealApiClient (настоящий backend по HTTP).
# false — использовать настоящий backend по VITE_API_BASE_URL ниже.
VITE_USE_MOCK_API=true

# Адрес backend (см. pdd-backend/docker-compose.yml — по умолчанию слушает :8000).
VITE_API_BASE_URL=http://localhost:8000

# Способ входа отвязан от источника данных. 'true' — форсировать mock-вход (фиксированный код,
# backend с OAUTH_ALLOW_MOCK=true) даже при VITE_USE_MOCK_API=false: реальные билеты/темы с
# backend + вход без зарегистрированных Yandex/VK OAuth-приложений. Не задан — как VITE_USE_MOCK_API.
VITE_MOCK_LOGIN=false

# Настоящий OAuth-редирект (нужен только при VITE_USE_MOCK_API=false и VITE_MOCK_LOGIN≠true) — см. README
# "Настоящий OAuth (Yandex/VK)". client_id публичный, не секрет (виден в адресной строке после
# редиректа), но без него кнопки входа выдадут понятную ошибку вместо редиректа на провайдера.
# VITE_YANDEX_OAUTH_CLIENT_ID=
# VITE_VK_OAUTH_CLIENT_ID=

# Опционально: переопределить authorize-эндпоинт провайдера, если зарегистрированное OAuth-
# приложение использует не классический endpoint (например VK ID вместо oauth.vk.com).
# VITE_YANDEX_OAUTH_AUTHORIZE_URL=
# VITE_VK_OAUTH_AUTHORIZE_URL=
