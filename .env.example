# Переключение между MockApiClient (фикстуры, поведение по умолчанию — все текущие
# unit/e2e-тесты рассчитаны на него) и RealApiClient (настоящий backend по HTTP).
# false — использовать настоящий backend по VITE_API_BASE_URL ниже.
VITE_USE_MOCK_API=true

# Адрес backend (см. pdd-backend/docker-compose.yml — по умолчанию слушает :8000).
VITE_API_BASE_URL=http://localhost:8000
